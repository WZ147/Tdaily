{
  "name": "tdaily-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Tdaily 桌面客户端",
  "author": "Tdaily",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tdaily.app",
    "productName": "Tdaily",
    "files": [
      "main.js",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Tdaily-${version}.exe"
    }
  }
}
